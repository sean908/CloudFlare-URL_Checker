{
  "name": "suc-bhecker",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",

  // [1] 配置 Cron 触发器，这里设置为每5分钟执行一次
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },

  // [2] 绑定一个 KV Namespace，我们把它命名为 STATUS_KV
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", // 替换成你生成的 ID
      "preview_id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" // 替换成你生成的 preview ID
    }
  ]
}

