{
	"name": "suc-bhecker",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-01",
	// [1] 配置 Cron 触发器，默认每5分钟执行一次（可在管理后台修改）
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// [2] 绑定 KV Namespace 用于存储站点列表、配置和状态
	"kv_namespaces": [
		{
			"binding": "STATUS_KV",
			"id": "N/A",
			"preview_id": "N/A"
		}
	],
	// [3] 环境变量配置（可选）
	"vars": {
		"EMAIL_FROM": "monitor@example.com",
		"LOG_LEVEL": "INFO"  // DEBUG | INFO | WARN | ERROR（默认 INFO）
	},
	// [4] Secrets（敏感信息，通过 wrangler secret put 设置）
	// wrangler secret put ADMIN_TOKEN         # 管理后台访问令牌（URL参数 ?tk=xxx）
	// wrangler secret put TELEGRAM_BOT_TOKEN  # Telegram Bot Token
	// wrangler secret put BARK_ENDPOINT       # 自建 Bark 服务端点（可选）
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}