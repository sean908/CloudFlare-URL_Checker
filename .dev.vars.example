# 本地开发环境变量示例
# 复制此文件为 .dev.vars 并填入真实值

# 管理后台访问令牌（必需）
ADMIN_TOKEN=your-strong-random-token-here

# Telegram Bot Token（可选，从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Bark 服务器端点（可选，仅自建服务器需要）
#BARK_ENDPOINT=http://your-bark-server:port

# 日志级别（DEBUG | INFO | WARN | ERROR）
LOG_LEVEL=DEBUG
